# Supabase (Configurações Públicas do Cliente)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Mercado Pago - Frontend (Apenas Chave Pública!)
# NUNCA exponha o ACCESS_TOKEN no frontend ou em variáveis com prefixo VITE_
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-chave-publica-aqui

# ==============================================================================
# SEGREDOS DE BACKEND / SUPABASE EDGE FUNCTIONS (Configurar via Supabase Secrets)
# ==============================================================================
# supabase secrets set MERCADOPAGO_ACCESS_TOKEN="APP_USR-seu-access-token-aqui"
# supabase secrets set MERCADOPAGO_WEBHOOK_SECRET="seu-webhook-secret-aqui"
